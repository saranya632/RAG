FLASK_ENV=development
FLASK_DEBUG=true
LOG_LEVEL=INFO

UPLOAD_FOLDER=./uploads
# 50 MB
MAX_CONTENT_LENGTH=52428800
# Keep the PDF in UPLOAD_FOLDER after it is stored in ChromaDB
KEEP_UPLOADED_FILES=true

CHUNK_SIZE=1000
CHUNK_OVERLAP=200

CHROMA_PERSIST_DIRECTORY=./data/chroma
CHROMA_COLLECTION_NAME=pdf_documents

# Local embedding model (no API key). Providers: fastembed | huggingface
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_BATCH_SIZE=64
EMBEDDING_CACHE_DIR=./data/models

# --- Stage 2: /chat ---------------------------------------------------------
# Local Qwen model served by Ollama (no API key needed)
QWEN_MODEL=qwen:1.8b
OLLAMA_BASE_URL=http://localhost:11434
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=384
# >1 stops small models repeating the same sentence
LLM_REPEAT_PENALTY=1.15
OLLAMA_NUM_CTX=4096
OLLAMA_TIMEOUT_SECONDS=120
# Thinking mode: only for models that support it (qwen3 -> false). Empty for qwen:1.8b
QWEN_REASONING=

# Candidate chunks fetched from ChromaDB per question (fed to the reranker)
RETRIEVAL_TOP_K=10
# Best chunks kept after reranking; only these are sent to Qwen
RERANK_TOP_K=4

# Reranker (cross-encoder, local ONNX via FastEmbed, cached in EMBEDDING_CACHE_DIR)
RERANKER_ENABLED=true
# ~1 GB, best quality. Faster English-only option: Xenova/ms-marco-MiniLM-L-6-v2 (~80 MB)
RERANKER_MODEL=BAAI/bge-reranker-base
# true = load at startup (first /chat is fast); false = load on first /chat
RERANKER_PRELOAD=true
# Cosine-distance cutoff: chunks farther away are ignored; none left -> 404 (empty = off)
RETRIEVAL_MAX_DISTANCE=0.45
MAX_QUESTION_LENGTH=2000

# --- Stage 3: users + authentication ----------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=rag_database

# Signs login tokens. Keep it secret; changing it logs everyone out.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change_me_to_a_long_random_value
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=60
PASSWORD_MIN_LENGTH=8

# --- Stage 4: React frontend ---------------------------------------------------
# Browser origins allowed to call the API (the Vite dev server)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
